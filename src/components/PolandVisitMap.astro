---
import { ArrowRight, BadgeCheck, Building2, CalendarDays, FileText, GraduationCap, MapPinned } from 'lucide';
import { withBase } from '../lib/paths';
import LucideIcon from './LucideIcon.astro';

type VisitItem = {
  id: string;
  city: string;
  date: string;
  title: string;
  institution: string;
  program: string;
  description: string;
  x: number;
  y: number;
};

const { visits = [], initialId }: { visits: VisitItem[]; initialId?: string } = Astro.props;

const startId = visits.some((visit) => visit.id === initialId) ? initialId : visits[0]?.id;
const startVisit = visits.find((visit) => visit.id === startId) ?? visits[0];
const cityMarkers = Array.from(
  visits.reduce((map, visit) => {
    if (!map.has(visit.city)) map.set(visit.city, visit);
    return map;
  }, new Map<string, VisitItem>()).values()
);
const startCityVisits = visits.filter((visit) => visit.city === startVisit?.city);
---

<div class="visit-map" data-visit-map data-initial-id={startId}>
  <div class="visit-map__visual">
    <div class="visit-map__shell">
      <div class="visit-map__artwork" aria-hidden="true">
        <div class="visit-map__figure">
          <img class="visit-map__image" src={withBase('/assets/maps/poland-shape.svg')} alt="" />
          <p class="visit-map__caption">Polska</p>

          {cityMarkers.map((visit) => (
            <button
              type="button"
              class={`visit-map__marker ${visit.id === startId ? 'is-active' : ''}`}
              style={`--marker-x:${visit.x}%; --marker-y:${visit.y}%;`}
              data-visit-city={visit.city}
              data-default-id={visit.id}
              aria-pressed={visit.id === startId ? 'true' : 'false'}
              aria-label={`${visit.city} - ${visit.title}`}
            >
              <span class="visit-map__marker-dot" aria-hidden="true"></span>
              <span class="visit-map__marker-label">{visit.city}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <article class="visit-map__panel" aria-live="polite">
    <div class="visit-map__panel-header">
      <div class="visit-map__panel-chip">
        <LucideIcon icon={BadgeCheck} size={15} />
        <span>Aktywność PKA</span>
      </div>

      <div class="visit-map__panel-top">
        <p class="visit-map__panel-date" data-visit-date>{startVisit?.date}</p>
        <button
          type="button"
          class:list={['visit-map__panel-next', startCityVisits.length > 1 ? 'is-visible' : undefined]}
          data-visit-next
        >
          <span data-visit-next-date>{startCityVisits[1]?.date}</span>
          <LucideIcon icon={ArrowRight} size={15} class="visit-map__panel-next-svg" />
        </button>
      </div>
    </div>

    <h3 data-visit-title>{startVisit?.title}</h3>

    <div class="visit-map__facts">
      <div class="visit-map__fact-card">
        <span class="visit-map__fact-icon" aria-hidden="true">
          <LucideIcon icon={MapPinned} size={18} />
        </span>
        <div>
          <p class="visit-map__fact-label">Miasto</p>
          <p class="visit-map__panel-city" data-visit-city-name>{startVisit?.city}</p>
        </div>
      </div>

      <div class="visit-map__fact-card">
        <span class="visit-map__fact-icon" aria-hidden="true">
          <LucideIcon icon={Building2} size={18} />
        </span>
        <div>
          <p class="visit-map__fact-label">Uczelnia</p>
          <p class="visit-map__panel-institution" data-visit-institution>{startVisit?.institution}</p>
        </div>
      </div>

      <div class="visit-map__fact-card">
        <span class="visit-map__fact-icon" aria-hidden="true">
          <LucideIcon icon={GraduationCap} size={18} />
        </span>
        <div>
          <p class="visit-map__fact-label">Kierunek</p>
          <p class="visit-map__panel-program" data-visit-program>{startVisit?.program}</p>
        </div>
      </div>

      <div class="visit-map__fact-card visit-map__fact-card--date">
        <span class="visit-map__fact-icon" aria-hidden="true">
          <LucideIcon icon={CalendarDays} size={18} />
        </span>
        <div>
          <p class="visit-map__fact-label">Termin</p>
          <p class="visit-map__panel-date-copy">{startVisit?.date}</p>
        </div>
      </div>
    </div>

    <div class="visit-map__summary">
      <div class="visit-map__summary-head">
        <span class="visit-map__fact-icon" aria-hidden="true">
          <LucideIcon icon={FileText} size={18} />
        </span>
        <p class="visit-map__fact-label">Opis działań</p>
      </div>
      <p class="visit-map__panel-description" data-visit-description>{startVisit?.description}</p>
    </div>
  </article>
</div>

<script define:vars={{ visits }}>
  const roots = document.querySelectorAll('[data-visit-map]');

  for (const root of roots) {
    const markerButtons = Array.from(root.querySelectorAll('button[data-visit-city]'));
    const dateEl = root.querySelector('[data-visit-date]');
    const titleEl = root.querySelector('[data-visit-title]');
    const cityEl = root.querySelector('[data-visit-city-name]');
    const institutionEl = root.querySelector('[data-visit-institution]');
    const programEl = root.querySelector('[data-visit-program]');
    const descEl = root.querySelector('[data-visit-description]');
    const dateCopyEl = root.querySelector('.visit-map__panel-date-copy');
    const nextButton = root.querySelector('[data-visit-next]');
    const nextDateEl = root.querySelector('[data-visit-next-date]');

    if (
      !markerButtons.length ||
      !dateEl ||
      !titleEl ||
      !cityEl ||
      !institutionEl ||
      !programEl ||
      !descEl ||
      !dateCopyEl ||
      !nextButton ||
      !nextDateEl
    ) continue;

    const visitMap = new Map(visits.map((visit) => [visit.id, visit]));
    const cityMap = new Map();

    for (const visit of visits) {
      const current = cityMap.get(visit.city) ?? [];
      current.push(visit);
      cityMap.set(visit.city, current);
    }

    const renderNextSwitch = (city, activeId, setActive) => {
      const cityVisits = cityMap.get(city) ?? [];

      if (cityVisits.length <= 1) {
        nextButton.classList.remove('is-visible');
        nextDateEl.textContent = '';
        nextButton.onclick = null;
        return;
      }

      const activeIndex = cityVisits.findIndex((visit) => visit.id === activeId);
      const nextIndex = activeIndex >= 0 ? (activeIndex + 1) % cityVisits.length : 0;
      const nextVisit = cityVisits[nextIndex];

      nextButton.classList.add('is-visible');
      nextDateEl.textContent = nextVisit.date;
      nextButton.onclick = () => setActive(nextVisit.id);
    };

    const setActive = (id) => {
      const active = visitMap.get(id);
      if (!active) return;

      for (const button of markerButtons) {
        const city = button.dataset.visitCity;
        const isActive = city === active.city;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }

      dateEl.textContent = active.date;
      titleEl.textContent = active.title;
      cityEl.textContent = active.city;
      institutionEl.textContent = active.institution;
      programEl.textContent = active.program;
      dateCopyEl.textContent = active.date;
      descEl.textContent = active.description;

      renderNextSwitch(active.city, active.id, setActive);
    };

    for (const button of markerButtons) {
      const activateCity = () => {
        const city = button.dataset.visitCity;
        if (!city) return;
        const firstVisit = cityMap.get(city)?.[0];
        if (firstVisit) setActive(firstVisit.id);
      };

      button.addEventListener('click', activateCity);
      button.addEventListener('mouseenter', activateCity);
      button.addEventListener('focus', activateCity);
    }

    const initialFromAttr = root.getAttribute('data-initial-id');
    if (initialFromAttr) setActive(initialFromAttr);
  }
</script>

<style>
  .visit-map {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.95fr);
    gap: 1rem;
    align-items: start;
  }

  .visit-map__visual,
  .visit-map__panel {
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    background: var(--card);
    padding: 1rem;
  }

  .visit-map__shell {
    position: relative;
    aspect-ratio: 1.18;
    border-radius: 0.9rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 10%, rgba(105, 210, 231, 0.16), transparent 42%),
      radial-gradient(circle at 80% 85%, rgba(246, 200, 95, 0.14), transparent 48%),
      rgba(10, 14, 22, 0.75);
  }

  .visit-map__artwork {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.2rem 1.6rem;
  }

  .visit-map__figure {
    position: relative;
    height: 90%;
    aspect-ratio: 1;
    transform: translateY(-3%);
  }

  .visit-map__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.95;
    filter:
      invert(1)
      brightness(1.45)
      drop-shadow(0 18px 28px rgba(0, 0, 0, 0.35));
  }

  .visit-map__caption {
    position: absolute;
    left: 50%;
    top: 42%;
    transform: translate(-50%, -50%);
    margin: 0;
    color: rgba(255, 255, 255, 0.14);
    font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
    font-size: 2.3rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .visit-map__marker {
    position: absolute;
    left: var(--marker-x);
    top: var(--marker-y);
    transform: translate(-50%, -50%);
    display: inline-grid;
    justify-items: center;
    gap: 0.32rem;
    border: 0;
    background: transparent;
    color: var(--text-main);
    cursor: pointer;
    padding: 0;
  }

  .visit-map__marker-dot {
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--accent);
    border: 2px solid #101317;
    box-shadow: 0 0 0 6px rgba(246, 200, 95, 0.12);
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .visit-map__marker-label {
    font-size: 0.72rem;
    line-height: 1.1;
    padding: 0.2rem 0.42rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(8, 12, 19, 0.8);
    white-space: nowrap;
  }

  .visit-map__marker:hover .visit-map__marker-dot,
  .visit-map__marker:focus-visible .visit-map__marker-dot,
  .visit-map__marker.is-active .visit-map__marker-dot {
    transform: scale(1.16);
    background: var(--accent-2);
    box-shadow: 0 0 0 8px rgba(105, 210, 231, 0.14);
  }

  .visit-map__marker:focus-visible {
    outline: none;
  }

  .visit-map__marker:hover .visit-map__marker-label,
  .visit-map__marker:focus-visible .visit-map__marker-label,
  .visit-map__marker.is-active .visit-map__marker-label {
    border-color: rgba(105, 210, 231, 0.4);
    color: #fff;
  }

  .visit-map__panel {
    display: grid;
    gap: 1rem;
    min-height: 100%;
    background:
      linear-gradient(180deg, rgba(105, 210, 231, 0.05), transparent 22%),
      var(--card);
  }

  .visit-map__panel-header {
    display: grid;
    gap: 0.85rem;
  }

  .visit-map__panel-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    padding: 0.36rem 0.62rem;
    border-radius: 999px;
    background: rgba(105, 210, 231, 0.1);
    color: var(--accent-2);
    border: 1px solid rgba(105, 210, 231, 0.18);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .visit-map__panel-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .visit-map__panel-date,
  .visit-map__panel-date-copy {
    margin: 0;
    font-size: 0.86rem;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .visit-map__panel-next {
    display: none;
    align-items: center;
    gap: 0.42rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-main);
    padding: 0.32rem 0.65rem;
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .visit-map__panel-next.is-visible {
    display: inline-flex;
  }

  .visit-map__panel-next:hover,
  .visit-map__panel-next:focus-visible {
    border-color: rgba(105, 210, 231, 0.38);
    transform: translateX(1px);
    outline: none;
  }

  .visit-map__panel h3 {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .visit-map__facts {
    display: grid;
    gap: 0.75rem;
  }

  .visit-map__fact-card,
  .visit-map__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.9rem;
    border-radius: 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }

  .visit-map__summary {
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  .visit-map__summary-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .visit-map__fact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    color: var(--accent-2);
    background: rgba(105, 210, 231, 0.08);
    border: 1px solid rgba(105, 210, 231, 0.14);
  }

  .visit-map__fact-label {
    margin: 0 0 0.22rem;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .visit-map__panel-city,
  .visit-map__panel-institution,
  .visit-map__panel-program,
  .visit-map__panel-description {
    margin: 0;
  }

  .visit-map__panel-city {
    color: var(--text-main);
    font-weight: 700;
    font-size: 1rem;
  }

  .visit-map__panel-institution,
  .visit-map__panel-description {
    color: var(--text-soft);
    line-height: 1.65;
  }

  .visit-map__panel-institution,
  .visit-map__panel-program {
    color: var(--text-main);
    font-weight: 700;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .visit-map {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .visit-map__artwork {
      padding: 0.9rem;
    }

    .visit-map__marker-label {
      font-size: 0.64rem;
      padding: 0.16rem 0.35rem;
    }
  }
</style>
