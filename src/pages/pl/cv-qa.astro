<PageLayout
  lang="pl"
  title="CV QA | Grzegorz Samson"
  description="Podstrona CV przygotowana pod zgłoszenie do zespołu ds. jakości kształcenia."
>
  <section class="content-stack">
    <div class="qa-section-heading">
      <span class="qa-section-icon" aria-hidden="true">
        <LucideIcon icon={BriefcaseBusiness} size={20} />
      </span>
      <div>
        <p class="section-kicker">Doświadczenie</p>
        <h2>Doświadczenie istotne dla jakości kształcenia</h2>
      </div>
    </div>

    <div class="qa-accordion-list">
      {experienceCards.map((card) => (
        <details class="qa-accordion-card">
          <summary class="qa-accordion-summary">
            <div class="qa-accordion-heading">
              <span class="qa-card-icon" aria-hidden="true">
                <LucideIcon icon={card.icon} size={18} />
              </span>
              <div>
                <p class="section-kicker">{card.meta}</p>
                <h3>{card.title}</h3>
              </div>
            </div>
            <span class="qa-accordion-icon" aria-hidden="true"></span>
          </summary>
          <div class="qa-accordion-body">
            <ul>
              {card.points.map((point) => (
                <li set:html={point}></li>
              ))}
            </ul>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="content-stack" id="wizytacje-pka">
    <div class="qa-section-heading">
