---
import PageLayout from '../../layouts/PageLayout.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import MediaEmbedYouTube from '../../components/MediaEmbedYouTube.astro';
import HorizontalTimeline from '../../components/HorizontalTimeline.astro';
import { withBase } from '../../lib/paths';

const guiItems = [
  {
    id: 'controls',
    title: 'Panel sterowania',
    shortDescription: 'Główna przestrzeń pracy i parametry syntezy granularnej.',
    imageSrc: withBase('/assets/plugin/controls-panel.png'),
    imageAlt: 'Panel sterowania we wtyczce GreggularVST',
    description:
      'Główna przestrzeń kształtowania dźwięku: czas trwania ziaren, wysokość, wzmocnienie, obwiednia i parametry chmury.',
    bullets: ['Parametry dla każdej próbki', 'Szybka iteracja', 'Kształtowanie granularne w czasie rzeczywistym'],
    tags: ['Czas trwania', 'Wysokość', 'Chmura']
  },
  {
    id: 'multichannel',
    title: 'Panel wielokanałowy',
    shortDescription: 'Trasowanie i panorama dla rozbudowanych konfiguracji wyjściowych.',
    imageSrc: withBase('/assets/plugin/multichannel-panel.png'),
    imageAlt: 'Panel wielokanałowy we wtyczce GreggularVST',
    description:
      'Sterowanie trasowaniem, wyciszaniem, solo i panoramą obsługuje pracę w stereo oraz rozbudowanych konfiguracjach wielokanałowych.',
    bullets: ['Trasowanie kanałów', 'Wycisz / solo', 'Panorama wielokanałowa'],
    tags: ['Trasowanie', 'Wielokanałowość', 'Panorama']
  },
  {
    id: 'audio-generator',
    title: 'Generator audio',
    shortDescription: 'Generowanie materiału źródłowego na podstawie poleceń.',
    imageSrc: withBase('/assets/plugin/audio-generator-panel.png'),
    imageAlt: 'Panel generatora audio we wtyczce GreggularVST',
    description:
      'Panel konwersacyjny do tworzenia materiału źródłowego i rozwijania pomysłów brzmieniowych przed transformacją granularną.',
    bullets: ['Praca z poleceniami', 'Wygenerowany materiał źródłowy', 'Kontekst sesji'],
    tags: ['Generator', 'Polecenie', 'Sesja']
  }
];

const initialPanel = guiItems[0];

const developmentStages = [
  {
    id: 'prototype',
    year: '2025',
    date: 'Badania prototypowe',
    label: 'Prototyp',
    title: 'Dwumodułowy proces przekształcania tekstu w dźwięk',
    description:
      'Wprowadzanie tekstu, generowanie audio i transformację granularną badano jako osobne moduły prototypu.'
  },
  {
    id: 'installation',
    year: '2025',
    date: 'Prezentacja artystyczna',
    label: 'Instalacja',
    title: 'Interaktywna instalacja dźwiękowa',
    description:
      'Technologie prototypowe wykorzystano w interaktywnej instalacji dźwiękowej zaprezentowanej podczas festiwalu artystycznego.'
  },
  {
    id: 'adc25',
    year: '2025',
    date: 'ADC 2025',
    label: 'ADC25',
    title: 'Od tekstowych życzeń do dźwięku',
    description:
      'Badania zaprezentowano online podczas ADC 2025 w formie posteru o generowaniu audio na podstawie tekstu i przetwarzaniu granularnym w czasie rzeczywistym.'
  },
  {
    id: 'greggular',
    year: '2025–2026',
    date: 'Projekt stypendialny',
    label: 'VST',
    title: 'GreggularVST',
    description:
      'Proces pracy połączono w jeden syntezator granularny JUCE/VST3 z wieloma źródłami, grupowaniem i trasowaniem wielokanałowym.'
  },
  {
    id: 'adc26',
    year: '2026',
    date: 'ADCx Gather / ADC26',
    label: 'ADC26',
    title: 'Greggular na ADC26',
    description:
      'Ta strona dokumentuje przejście od prototypów do zintegrowanego instrumentu i przedstawia proces twórczy opracowany na ADC26.'
  },
  {
    id: 'hybrid',
    year: '2026',
    date: 'Aktualny kierunek badań',
    label: 'Hybryda',
    title: 'Interaktywny instrument hybrydowy',
    description:
      'Kolejny etap rozwija instrument programowy w kierunku hybrydowego systemu performatywnego łączącego dźwięk, elementy wizualne i interakcję z wykonawcą.'
  }
];
---

<PageLayout
  lang="pl"
  title="Greggular na ADC26 | Grzegorz Samson"
  description="Materiały badawcze na ADC26 poświęcone Greggular — instrumentowi granularnemu JUCE/VST3 do generowania dźwięku na podstawie tekstu, generatywnego audio i wielokanałowych procesów twórczych."
  showProjectFooter={false}
>
  <div class="adc26-page">
    <section class="adc26-hero">
      <div class="adc26-hero__copy">
        <p class="section-kicker section-kicker--with-icon">
          <LucideIcon name="presentation" class="section-kicker__icon" />
          ADC26 · Poster badawczy
        </p>

        <div class="adc26-event-row" aria-label="Daty konferencji">
          <span>ADCx Gather · 16 października 2026</span>
          <span>ADC26 Bristol i online · 9–11 listopada 2026</span>
        </div>

        <h1>Greggular</h1>
        <p class="adc26-hero__title">Granularna wtyczka VST do generowania dźwięku na podstawie tekstu</p>
        <p class="lead adc26-hero__lead">
          Od dwumodułowego prototypu przekształcającego tekst w dźwięk, zaprezentowanego na ADC 2025, do zintegrowanego środowiska JUCE/VST3 do generatywnego audio, przetwarzania granularnego w czasie rzeczywistym i wielokanałowych procesów twórczych.
        </p>

        <div class="badge-row" aria-label="Technologie projektu">
          <span class="badge">JUCE / VST3</span>
          <span class="badge">Synteza granularna</span>
          <span class="badge">Generatywne audio</span>
          <span class="badge">Wielokanałowość</span>
          <span class="badge">Bezpłatny program</span>
        </div>

        <div class="hero-cta-row">
          <a class="button button-primary" href="#system">Poznaj system</a>
          <a class="button button-ghost" href="#demos">Zobacz prezentacje</a>
          <a class="button button-ghost" href={withBase('/pl/plugin/')}>Pełna strona wtyczki</a>
        </div>

        <p class="adc26-byline">Poster badawczy Grzegorza Samsona</p>
      </div>

      <a class="adc26-hero__media" href={withBase('/pl/plugin/#panels')}>
        <img
          src={withBase('/assets/plugin/controls-panel.png')}
          alt="Panel sterowania wtyczki GreggularVST"
          loading="eager"
          decoding="async"
        />
        <span>Otwórz pełną dokumentację wtyczki ↗</span>
      </a>
    </section>

    <section id="evolution" class="content-stack">
      <p class="section-kicker section-kicker--with-icon">
        <LucideIcon name="history" class="section-kicker__icon" />
        Rozwój badań
      </p>
      <h2 class="section-title-with-icon">
        <LucideIcon name="milestone" class="section-title__icon" />
        <span>Od ADC 2025 do ADC 2026</span>
      </h2>

      <div class="adc26-comparison">
        <article class="adc26-comparison__card">
          <div class="adc26-card-label">ADC 2025 · Prototyp</div>
          <a
            class="adc26-comparison__media adc26-comparison__media--poster"
            href={withBase('/assets/research/from-text-wishes-to-sound-adc-2025-poster.jpg')}
            target="_blank"
            rel="noreferrer"
          >
            <img
              src={withBase('/assets/research/from-text-wishes-to-sound-adc-2025-poster-thumb.jpg')}
              alt="Poster „Od tekstowych życzeń do dźwięku” zaprezentowany na ADC 2025"
              loading="lazy"
              decoding="async"
            />
          </a>
          <h3>Od tekstowych życzeń do dźwięku</h3>
          <p>Tekst → generatywne audio → przetwarzanie granularne.</p>
          <ul>
            <li>Dwa moduły prototypowe</li>
            <li>Eksperymentalny proces oparty na tekście</li>
            <li>Transformacja granularna w czasie rzeczywistym</li>
          </ul>
        </article>

        <div class="adc26-comparison__arrow" aria-hidden="true">→</div>

        <article class="adc26-comparison__card adc26-comparison__card--current">
          <div class="adc26-card-label">ADC 2026 · Zintegrowany instrument</div>
          <a class="adc26-comparison__media" href={withBase('/pl/plugin/')}>
            <img
              src={withBase('/assets/plugin/controls-panel.png')}
              alt="Interfejs GreggularVST"
              loading="lazy"
              decoding="async"
            />
          </a>
          <h3>GreggularVST</h3>
          <p>Materiał wygenerowany lub wcześniej nagrany → instrument granularny → wyjście wielokanałowe.</p>
          <ul>
            <li>Zintegrowany proces pracy JUCE/VST3</li>
            <li>Wiele równocześnie działających generatorów granularnych</li>
            <li>Grupowanie, trasowanie i sterowanie parametrami próbek</li>
          </ul>
        </article>
      </div>
    </section>

    <section id="system" class="content-stack">
      <p class="section-kicker section-kicker--with-icon">
        <LucideIcon name="waypoints" class="section-kicker__icon" />
        System w skrócie
      </p>
      <h2 class="section-title-with-icon">
        <LucideIcon name="audio-waveform" class="section-title__icon" />
        <span>Proces przekształcania tekstu w dźwięk</span>
      </h2>

      <div class="adc26-flow" aria-label="Przepływ przetwarzania GreggularVST">
        <div class="adc26-flow__sources">
          <article class="adc26-flow__node">
            <span class="adc26-flow__eyebrow">Źródło A</span>
            <strong>Polecenie tekstowe</strong>
            <span>Wygenerowany materiał audio</span>
          </article>
          <article class="adc26-flow__node">
            <span class="adc26-flow__eyebrow">Źródło B</span>
            <strong>Wcześniej nagrane audio</strong>
            <span>Zaimportowany materiał źródłowy</span>
          </article>
        </div>
        <div class="adc26-flow__arrow" aria-hidden="true">↓</div>
        <article class="adc26-flow__node adc26-flow__node--accent">
          <span class="adc26-flow__eyebrow">Instrument</span>
          <strong>Wspólna pula próbek</strong>
          <span>Wybór, grupowanie i konfiguracja próbek</span>
        </article>
        <div class="adc26-flow__arrow" aria-hidden="true">↓</div>
        <article class="adc26-flow__node adc26-flow__node--accent2">
          <span class="adc26-flow__eyebrow">Czas rzeczywisty</span>
          <strong>Przetwarzanie granularne</strong>
          <span>Wiele generatorów · wysokość · wzmocnienie · obwiednia · chmura</span>
        </article>
        <div class="adc26-flow__arrow" aria-hidden="true">↓</div>
        <article class="adc26-flow__node">
          <span class="adc26-flow__eyebrow">Wyjście</span>
          <strong>Grupowanie i trasowanie wielokanałowe</strong>
          <span>Procesy pracy na potrzeby wykonawstwa, kompozycji i projektowania dźwięku</span>
        </article>
      </div>
    </section>

    <section class="content-stack">
      <p class="section-kicker section-kicker--with-icon">
        <LucideIcon name="sparkles" class="section-kicker__icon" />
        Idea badawcza
      </p>
      <h2 class="section-title-with-icon">
        <LucideIcon name="flask-conical" class="section-title__icon" />
        <span>Technologie generatywne jako materiał twórczy</span>
      </h2>

      <div class="text-panel adc26-research-note">
        <p>
          Projekt bada kreatywne i odpowiedzialne wykorzystanie nowych technologii generatywnych w pracy artystycznej. Wygenerowany dźwięk nie jest traktowany jako gotowy rezultat, lecz jako materiał źródłowy, który artysta może wybierać, przekształcać i kształtować w czasie rzeczywistym.
        </p>
      </div>

      <div class="adc26-principles">
        <article>
          <LucideIcon name="sparkles" />
          <h3>Generuj</h3>
          <p>Twórz nowy materiał źródłowy lub importuj istniejące nagrania.</p>
        </article>
        <article>
          <LucideIcon name="audio-waveform" />
          <h3>Przekształcaj</h3>
          <p>Kształtuj materiał za pomocą szczegółowego przetwarzania granularnego w czasie rzeczywistym.</p>
        </article>
        <article>
          <LucideIcon name="presentation" />
          <h3>Wykonuj</h3>
          <p>Łącz, grupuj i trasuj rozwijające się struktury za pomocą interaktywnego instrumentu.</p>
        </article>
      </div>
    </section>

    <section id="interface" class="content-stack">
      <p class="section-kicker section-kicker--with-icon">
        <LucideIcon name="sliders-horizontal" class="section-kicker__icon" />
        Poznaj interfejs
      </p>
      <h2 class="section-title-with-icon">
        <LucideIcon name="sliders-horizontal" class="section-title__icon" />
        <span>Trzy elementy procesu pracy</span>
      </h2>

      <div class="plugin-panels" data-plugin-panels data-initial-id={initialPanel.id}>
        <div class="plugin-panels-nav">
          {guiItems.map((item) => (
            <button
              type="button"
              class={`plugin-panel-tile ${item.id === initialPanel.id ? 'is-active' : ''}`}
              data-panel-id={item.id}
              aria-pressed={item.id === initialPanel.id ? 'true' : 'false'}
            >
              <img src={item.imageSrc} alt="" aria-hidden="true" loading="lazy" />
              <span class="plugin-panel-tile__body">
                <span class="plugin-panel-tile__title">{item.title}</span>
                <span class="plugin-panel-tile__description">{item.shortDescription}</span>
                <span class="plugin-tag-row">
                  {item.tags.map((tag) => <span class="plugin-tag">{tag}</span>)}
                </span>
              </span>
            </button>
          ))}
        </div>

        <article class="plugin-panel-active" data-panel-active aria-live="polite">
          <div class="plugin-panel-active__media">
            <img src={initialPanel.imageSrc} alt={initialPanel.imageAlt} loading="lazy" data-active-image />
            <p class="plugin-panel-active__caption" data-active-caption>{initialPanel.shortDescription}</p>
          </div>
          <div class="plugin-panel-active__content">
            <p class="plugin-panel-active__kicker">Aktywny panel</p>
            <h3 data-active-title>{initialPanel.title}</h3>
            <p class="plugin-panel-active__description" data-active-description>{initialPanel.description}</p>
            <section class="plugin-panel-active__highlights">
              <h4>Szczegóły panelu</h4>
              <ul data-active-bullets>
                {initialPanel.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </section>
            <div class="plugin-panel-active__switch" aria-label="Nawigacja między panelami">
              <button type="button" class="plugin-panel-active__arrow" data-panel-prev aria-label="Poprzedni panel">←</button>
              <button type="button" class="plugin-panel-active__arrow" data-panel-next aria-label="Następny panel">→</button>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section id="demos" class="content-stack">
      <p class="section-kicker section-kicker--with-icon">
        <LucideIcon name="video" class="section-kicker__icon" />
        Zobacz Greggular w działaniu
      </p>
      <h2 class="section-title-with-icon">
        <LucideIcon name="video" class="section-title__icon" />
        <span>Prezentacje wideo</span>
      </h2>

      <div class="plugin-video-grid">
        <article class="plugin-video-card">
          <MediaEmbedYouTube url="https://youtu.be/408RIow4tQE" title="GreggularVST — prezentacja I" />
          <div class="text-panel plugin-video-card__content">
            <h3>Prezentacja I · Proces pracy</h3>
            <p>Generatywny materiał źródłowy, transformacja granularna i główny proces pracy w GreggularVST.</p>
          </div>
        </article>

        <article class="plugin-video-card">
          <MediaEmbedYouTube url="https://youtu.be/0Vzin_ilv40" title="GreggularVST — prezentacja II" />
          <div class="text-panel plugin-video-card__content">
            <h3>Prezentacja II · Interfejs</h3>
            <p>Dodatkowa prezentacja interfejsu, parametrów i pracy z panelem granularnym.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="content-stack">
      <p class="section-kicker section-kicker--with-icon">
        <LucideIcon name="milestone" class="section-kicker__icon" />
        Ścieżka rozwoju
      </p>
      <h2 class="section-title-with-icon">
        <LucideIcon name="history" class="section-title__icon" />
        <span>Od prototypu do instrumentu hybrydowego</span>
      </h2>
      <HorizontalTimeline items={developmentStages} initialId="adc26" />
    </section>

    <section class="content-stack">
      <p class="section-kicker section-kicker--with-icon">
        <LucideIcon name="layers-2" class="section-kicker__icon" />
        Najważniejsze rezultaty
      </p>
      <div class="adc26-outcomes">
        <article>
          <h3>Oprogramowanie</h3>
          <p>Instrument granularny JUCE/VST3 z przetwarzaniem wielu źródeł w czasie rzeczywistym.</p>
        </article>
        <article>
          <h3>Badania</h3>
          <p>Procesy twórcze oparte na przekształcaniu tekstu w dźwięk i generowaniu audio, rozwijane w kolejnych prototypach.</p>
        </article>
        <article>
          <h3>Praktyka artystyczna</h3>
          <p>Technologie prototypowe przetestowane w kontekście interaktywnej instalacji dźwiękowej.</p>
        </article>
        <article>
          <h3>Otwarty dostęp</h3>
          <p>Bezpłatne wydanie, publiczna dokumentacja, prezentacje i materiały konferencyjne.</p>
        </article>
      </div>
    </section>

    <section class="adc26-resources content-stack">
      <p class="section-kicker section-kicker--with-icon">
        <LucideIcon name="external-link" class="section-kicker__icon" />
        Więcej informacji
      </p>
      <h2>Materiały i kontakt</h2>
      <p>
        GreggularVST powstał w ramach projektu stypendialnego „Nowe technologie w rozwijaniu narzędzi i kompetencji technologicznych dla muzyki współczesnej”, realizowanego w latach 2025–2026 i finansowanego przez Unię Europejską w ramach NextGenerationEU.
      </p>

      <div class="adc26-resource-grid">
        <a href="https://conference.audio.dev/schedule/" target="_blank" rel="noreferrer">Oficjalny harmonogram ADC26 <span>↗</span></a>
        <a href={withBase('/pl/plugin/')}>Dokumentacja GreggularVST <span>↗</span></a>
        <a href={withBase('/pl/plugin/#download')}>Pobierz GreggularVST <span>↗</span></a>
        <a href={withBase('/pl/research/')}>Poster badawczy ADC 2025 <span>↗</span></a>
        <a href={withBase('/pl/bio/')}>Badania, publikacje i biografia <span>↗</span></a>
      </div>

      <div class="adc26-author">
        <div>
          <strong>Grzegorz Samson</strong>
          <p>Realizator dźwięku · informatyk · twórca oprogramowania audio · początkujący badacz</p>
        </div>
        <div class="adc26-author__meta">
          <span>Discord: @grzegorzsamson</span>
          <a href={withBase('/pl/bio/')}>O autorze ↗</a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<script define:vars={{ guiItems }}>
  const roots = document.querySelectorAll('[data-plugin-panels]');

  for (const root of roots) {
    const buttons = Array.from(root.querySelectorAll('button[data-panel-id]'));
    const activeCard = root.querySelector('[data-panel-active]');
    const image = root.querySelector('[data-active-image]');
    const caption = root.querySelector('[data-active-caption]');
    const title = root.querySelector('[data-active-title]');
    const description = root.querySelector('[data-active-description]');
    const bullets = root.querySelector('[data-active-bullets]');
    const prevButton = root.querySelector('[data-panel-prev]');
    const nextButton = root.querySelector('[data-panel-next]');

    if (!buttons.length || !activeCard || !image || !caption || !title || !description || !bullets) continue;

    const itemMap = new Map(guiItems.map((item) => [item.id, item]));
    const ids = buttons
      .map((button) => button.dataset.panelId)
      .filter((value) => typeof value === 'string' && value.length > 0);
    let activeId = ids[0] ?? '';

    const setActive = (id, scrollToCard = true) => {
      const item = itemMap.get(id);
      if (!item) return;
      activeId = id;

      for (const button of buttons) {
        const isActive = button.dataset.panelId === id;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }

      image.setAttribute('src', item.imageSrc);
      image.setAttribute('alt', item.imageAlt);
      caption.textContent = item.shortDescription ?? item.description;
      title.textContent = item.title;
      description.textContent = item.description;

      bullets.textContent = '';
      for (const entry of item.bullets ?? []) {
        const li = document.createElement('li');
        li.textContent = entry;
        bullets.appendChild(li);
      }

      const activeIndex = ids.indexOf(id);
      if (prevButton instanceof HTMLButtonElement) prevButton.disabled = activeIndex <= 0;
      if (nextButton instanceof HTMLButtonElement) nextButton.disabled = activeIndex === -1 || activeIndex >= ids.length - 1;

      if (scrollToCard) activeCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const id = button.dataset.panelId;
        if (id) setActive(id, true);
      });
    }

    prevButton?.addEventListener('click', () => {
      const index = ids.indexOf(activeId);
      if (index > 0) setActive(ids[index - 1], true);
    });

    nextButton?.addEventListener('click', () => {
      const index = ids.indexOf(activeId);
      if (index >= 0 && index < ids.length - 1) setActive(ids[index + 1], true);
    });

    const initialId = root.getAttribute('data-initial-id');
    if (initialId) setActive(initialId, false);
  }
</script>

<style>
  .plugin-panel-tile__title {
    color: var(--text-main);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .plugin-panel-tile__description {
    color: var(--text-soft);
    font-size: 0.8rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
