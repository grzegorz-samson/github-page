---
import PageLayout from '../../layouts/PageLayout.astro';
import Timeline from '../../components/Timeline.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import { withBase } from '../../lib/paths';
---

<PageLayout
  lang="pl"
  title="Stypendium | Projekt stypendialny"
  description="Kamienie milowe i szkolenia zrealizowane w ramach projektu stypendialnego."
>
  <section class="content-stack">
    <p class="section-kicker section-kicker--with-icon"><LucideIcon name="award" class="section-kicker__icon" />Stypendium</p>
    <h2 class="section-title-with-icon"><LucideIcon name="milestone" class="section-title__icon" /><span>Kamienie milowe projektu</span></h2>
    <Timeline
      items={[
        { label: 'Kursy i szkolenia (zadanie 1)', date: '09.2025 - 10.2025', status: 'done', statusLabel: 'zrealizowane', href: withBase('/pl/scholarship/#training'), hrefLabel: 'Zobacz certyfikaty' },
        { label: 'Konferencja międzynarodowa (zadanie 2)', date: '10.2025 - 11.2025', status: 'done', statusLabel: 'zrealizowane', href: withBase('/pl/research/'), hrefLabel: 'Zobacz badania' },
        { label: 'Opracowanie koncepcji i realizacja wtyczki VST (zadanie 3)', date: '10.2025 - 12.2025', status: 'done', statusLabel: 'zrealizowane', href: withBase('/pl/plugin/'), hrefLabel: 'Zobacz wtyczkę' },
        { label: 'Kompozycja z wykorzystaniem narzędzia (zadanie 4)', date: '12.2025 - 01.2026', status: 'done', statusLabel: 'zrealizowane', href: withBase('/pl/project/#composition'), hrefLabel: 'Zobacz kompozycję' },
        { label: 'Warsztaty i wykłady otwarte (zadanie 5)', date: '12.2025 - 02.2026', status: 'done', statusLabel: 'zrealizowane', href: withBase('/pl/workshops/'), hrefLabel: 'Zobacz warsztaty' },
        { label: 'Dokumentacja i dystrybucja rezultatów (zadanie 6)', date: '01.2026 - 02.2026', status: 'done', statusLabel: 'zrealizowane', href: withBase('/pl/project/'), hrefLabel: 'Zobacz projekt' }
      ]}
    />
  </section>

  <section id="training" class="content-stack">
    <p class="section-kicker section-kicker--with-icon"><LucideIcon name="graduation-cap" class="section-kicker__icon" />Szkolenia</p>
    <h2 class="section-title-with-icon"><LucideIcon name="graduation-cap" class="section-title__icon" /><span>Certificates</span></h2>
    <div class="publication-list">
      <article class="publication-card">
        <h3>Signal Processing Onramp (MATLAB)</h3>
        <p class="publication-meta">Kurs ukończony w ramach działań stypendialnych.</p>
        <div class="publication-links">
          <a class="button button-primary" href={withBase('/assets/certificates/certyfikat-kurs-1-matlab.pdf')} target="_blank" rel="noreferrer">
            Otwórz certyfikat
          </a>
        </div>
      </article>

      <article class="publication-card">
        <h3>Core Designer Certificate (Dataiku)</h3>
        <p class="publication-meta">Certyfikat nr: cuocwr5rxq98</p>
        <div class="publication-links">
          <a class="button button-primary" href={withBase('/assets/certificates/certyfikat-kurs-2-dataiku.pdf')} target="_blank" rel="noreferrer">
            Otwórz certyfikat
          </a>
          <a class="button button-ghost" href="https://verify.skilljar.com/c/cuocwr5rxq98" target="_blank" rel="noreferrer">
            Weryfikacja
          </a>
        </div>
      </article>

      <article class="publication-card">
        <h3>Introduction to Generative AI - Art of the Possible (AWS)</h3>
        <p class="publication-meta">Kurs ukończony w ramach działań stypendialnych.</p>
        <div class="publication-links">
          <a class="button button-primary" href={withBase('/assets/certificates/certyfikat-kurs-3-aws.pdf')} target="_blank" rel="noreferrer">
            Otwórz certyfikat
          </a>
        </div>
      </article>
    </div>
  </section>
</PageLayout>
