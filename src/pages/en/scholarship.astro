---
import PageLayout from '../../layouts/PageLayout.astro';
import Timeline from '../../components/Timeline.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import { withBase } from '../../lib/paths';
---

<PageLayout
  lang="en"
  title="Scholarship | Scholarship project"
  description="Milestones and training completed as part of the scholarship project."
>
  <section class="content-stack">
    <p class="section-kicker section-kicker--with-icon"><LucideIcon name="award" class="section-kicker__icon" />Scholarship</p>
    <h2 class="section-title-with-icon"><LucideIcon name="milestone" class="section-title__icon" /><span>Project milestones</span></h2>
    <Timeline
      items={[
        { label: 'Courses and training (task 1)', date: '09.2025 - 10.2025', status: 'done', statusLabel: 'completed', href: withBase('/en/scholarship/#training'), hrefLabel: 'View certificates' },
        { label: 'International conference (task 2)', date: '10.2025 - 11.2025', status: 'done', statusLabel: 'completed', href: withBase('/en/research/'), hrefLabel: 'View research' },
        { label: 'VST plugin concept and implementation (task 3)', date: '10.2025 - 12.2025', status: 'done', statusLabel: 'completed', href: withBase('/en/plugin/'), hrefLabel: 'View plugin' },
        { label: 'Composition with the tool (task 4)', date: '12.2025 - 01.2026', status: 'done', statusLabel: 'completed', href: withBase('/en/project/#composition'), hrefLabel: 'View composition' },
        { label: 'Workshops and public lectures (task 5)', date: '12.2025 - 02.2026', status: 'done', statusLabel: 'completed', href: withBase('/en/workshops/'), hrefLabel: 'View workshops' },
        { label: 'Documentation and distribution of outcomes (task 6)', date: '01.2026 - 02.2026', status: 'done', statusLabel: 'completed', href: withBase('/en/project/'), hrefLabel: 'View project' }
      ]}
    />
  </section>

  <section id="training" class="content-stack">
    <p class="section-kicker section-kicker--with-icon"><LucideIcon name="graduation-cap" class="section-kicker__icon" />Training</p>
    <h2 class="section-title-with-icon"><LucideIcon name="graduation-cap" class="section-title__icon" /><span>Certificates</span></h2>
    <div class="publication-list">
      <article class="publication-card">
        <h3>Signal Processing Onramp (MATLAB)</h3>
        <p class="publication-meta">Course completed within scholarship activities.</p>
        <div class="publication-links">
          <a class="button button-primary" href={withBase('/assets/certificates/certyfikat-kurs-1-matlab.pdf')} target="_blank" rel="noreferrer">
            Open certificate
          </a>
        </div>
      </article>

      <article class="publication-card">
        <h3>Core Designer Certificate (Dataiku)</h3>
        <p class="publication-meta">Certificate no: cuocwr5rxq98</p>
        <div class="publication-links">
          <a class="button button-primary" href={withBase('/assets/certificates/certyfikat-kurs-2-dataiku.pdf')} target="_blank" rel="noreferrer">
            Open certificate
          </a>
          <a class="button button-ghost" href="https://verify.skilljar.com/c/cuocwr5rxq98" target="_blank" rel="noreferrer">
            Verification
          </a>
        </div>
      </article>

      <article class="publication-card">
        <h3>Introduction to Generative AI - Art of the Possible (AWS)</h3>
        <p class="publication-meta">Course completed within scholarship activities.</p>
        <div class="publication-links">
          <a class="button button-primary" href={withBase('/assets/certificates/certyfikat-kurs-3-aws.pdf')} target="_blank" rel="noreferrer">
            Open certificate
          </a>
        </div>
      </article>
    </div>
  </section>
</PageLayout>
